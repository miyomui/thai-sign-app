# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# ถ้าเว้นว่าง แอปจะใช้ข้อมูล mock ใน features/*/mock/

# Supabase → Project Settings → API (ใช้ anon key เท่านั้น ห้ามใช้ service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Unity WebGL build (เช่น /avatar/index.html) — เว้นว่าง = แสดง placeholder
VITE_AVATAR_URL=
